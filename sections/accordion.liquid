{%- liquid
  echo 'accordion.css' | asset_url | stylesheet_tag

  render 'accordion', settings: section.settings

  echo 'accordion.js' | asset_url | script_tag
-%}

{% schema %}
{
  "name": "Accordion",
  "settings": [
    {
      "type": "checkbox",
      "id": "accordion_multiple_mode",
      "label": "Open multiple accordions",
      "default": false
    },
    {
      "type": "text",
      "id": "accordion_title",
      "label": "Accordion Title",
      "default": "Privacy Statement"
    },
    {
      "type": "textarea",
      "id": "accordion_description",
      "label": "Accordion Description"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "accordion_question",
          "label": "Accordion Question"
        },
        {
          "type": "textarea",
          "id": "accordion_answer",
          "label": "Accordion Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordion"
    }
  ]
}
{% endschema %}

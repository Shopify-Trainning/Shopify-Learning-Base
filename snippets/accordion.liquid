{%- liquid
  assign accordion_title = settings.accordion_title
  assign accordion_description = settings.accordion_description
  echo 'accordion.css' | asset_url | stylesheet_tag
-%}

<section class="accordion">
  <div class="accordion__item">
    <div class="accordion__title">
      <h1>{{ accordion_title }}</h1>
    </div>
    <div class="accordion__description">
      <p>{{ accordion_description }}</p>
    </div>
    {%- for block in section.blocks -%}
      {%- liquid
        assign accordion_question = block.settings.accordion_question
        assign accordion_answer = block.settings.accordion_answer
      -%}
      {%- if accordion_question != blank -%}
        <div class="accordion__content">
          <div class="accordion__header">
            <h2 class="accordion__question">{{ accordion_question }}</h2>
            <span class="accordion__icon">+</span>
          </div>
          <div class="accordion__body">
            <p class="accordion__answer">{{ accordion_answer }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

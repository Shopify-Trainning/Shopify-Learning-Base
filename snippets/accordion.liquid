<accordion-custom class="accordion" data-single="true">
  {%- for block in section.blocks -%}
    {%- liquid
      assign accordion_question = block.settings.accordion_question
      assign accordion_answer = block.settings.accordion_answer
    -%}
    {%- if accordion_question != blank -%}
      <div class="accordion__item">
        <div class="accordion__item-title js-accordion-title">
          {{ accordion_question }}
          <span class="accordion__item-icon">V</span>
        </div>
        <div class="accordion__item-content">
          {{ accordion_answer }}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</accordion-custom>
